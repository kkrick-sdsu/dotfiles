[include]
  path = ~/.config/git/.gitconfig
  path = ~/.gitconfig.local
[user]
	name = Kyle Krick
	email = kkrick@sdsu.edu
[core]
	autocrlf = input
	editor = nvim
[init]
	defaultBranch = main
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
